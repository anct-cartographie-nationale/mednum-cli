# Publication sur data.gouv — commande `publier`
# En développement, pointer vers l'API de démonstration : la commande écrit réellement.
DATA_GOUV_API_URL="https://demo.data.gouv.fr/api/1"
DATA_GOUV_API_KEY=""
DATA_GOUV_REFERENCE_TYPE="organization"
DATA_GOUV_REFERENCE_ID=""

# Extraction depuis data.inclusion — commande `data-inclusion`
# Les deux dernières ont un équivalent en option de ligne de commande, qui l'emporte.
DATA_INCLUSION_API_KEY=""
DATA_INCLUSION_OUTPUT_FILE=""
DATA_INCLUSION_FILTER=""

# Sources authentifiées — commande `transformer`
# La source ne nomme pas la clé, elle nomme la variable qui la porte : le script
# `transformer.coop-numerique` passe `-a "COOP_API_KEY"`, et la commande lit celle-ci.
COOP_API_KEY=""
